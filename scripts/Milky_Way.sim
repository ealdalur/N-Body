# ── Milky Way ───────────────────
#
# Unit system (G=1):
#   1 distance unit = 60 pc = 0.060 kpc
#   1 mass unit     = 10^4 solar masses
#   1 velocity unit = 1 km/s
#   1 time unit     = 58.7 Myr
#
# Physical parameters:
#
# MILKY WAY
#   Disc radius:         26.8 kpc (446.7 code units)
#   Central body mass:   1.5e10 Msun (bulge, includes Sgr A* at 4e6 Msun)
#   Disc mass:           4.5e10 Msun (Mfrac=3.0, each of 39999 particles ~ 1.1e6 Msun)
#   Rotation curve:      ~220 km/s (flat, set by dark matter halo)
#   DM halo core radius: 10 kpc (166.7 code units)
#   Disc orientation:    x-z plane, normal = (0, 1, 0)
#   Rotation:            counter-clockwise viewed from +y

G               1.0
FDE             0.0
dt              0.0005
r_soft          0.1
BH_Opening_Theta  0.5

Gravity         Octree

DataLog         0
RecordVideo     0

# 40,000 bodies per galaxy = 80,000 total
N_SystemBodies  100000

# ── Camera ─────────────────────────────────────────
# Positioned to see both galaxies (midpoint elevated)
Camera          0.0  300.0  700.0

# ── Initial Conditions ─────────────────────────────
